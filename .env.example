# Скопируй этот файл в .env и заполни своими значениями.
# Файл .env НИКУДА не публикуй — там твои секреты.

# Токен от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнай у @userinfobot)
ADMIN_ID=

# Username основного канала без @ (для проверки подписки юзеров)
MAIN_CHANNEL_USERNAME=basefrom50

# ID закрытого канала с материалами ULTIMATE GUIDE
PRIVATE_CHANNEL_ID=-1003552231781

# YooMoney
YOOMONEY_WALLET=4100118793697883
YOOMONEY_TOKEN=
# Секрет из настроек HTTP-уведомлений ЮMoney (не OAuth-токен)
YOOMONEY_SECRET=
# OAuth-токену нужны права operation-history для проверки по кнопке и восстановления
# Ссылка на опубликованную публичную оферту; до публикации оставить пустой
OFFER_URL=
PRICE_ULTIMATE_GUIDE=1990
DB_PATH=data/bot.db

# Соцсети (опционально, можно оставить пустыми)
YOUTUBE_LINK=
TIKTOK_LINK=
